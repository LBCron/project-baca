# Project Baca — production API image (stateless Axum, :8080).
FROM rust:1.98-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo
COPY crates ./crates
RUN cargo build --release -p server

FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
# wget serves the compose healthcheck; the slim base ships without it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/server /usr/local/bin/server
# Two malloc arenas instead of one per core: 256 concurrent readers peaked
# at 61 MB RSS instead of 72 MB with the same throughput.
ENV MALLOC_ARENA_MAX=2
# A fixed mmap threshold keeps every 19 MiB Argon2 buffer on its own mapping,
# returned on free: with glibc's sliding threshold they land in the arenas
# and 100 parallel logins peaked at 814 MB instead of 189 MB.
ENV MALLOC_MMAP_THRESHOLD_=131072
# The API writes nothing to disk, so it runs as an unprivileged id.
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:8080/health | grep -q '"status":"healthy"' || exit 1
CMD ["server"]
