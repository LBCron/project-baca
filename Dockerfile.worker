# Project Baca — ingestion worker image (Redis Streams consumer).
FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
WORKDIR /worker
COPY python_worker/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY python_worker/worker.py ./
# EPUBs are parsed in memory; the worker needs no writable path, so it runs
# as an unprivileged id and skips bytecode caches it could not write.
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD ["python", "worker.py", "--healthcheck"]
CMD ["python", "worker.py"]
