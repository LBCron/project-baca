# Project Baca — ingestion worker image (Redis Streams consumer).
FROM python:3.12-slim
WORKDIR /worker
COPY python_worker/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY python_worker/worker.py ./
# EPUBs are parsed in memory; the worker needs no writable path, so it runs
# as an unprivileged id and skips bytecode caches it could not write.
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
CMD ["python", "worker.py"]
