# ==============================================================================
# Project Baca — Production environment (.env.production.example)
# Copy to `.env.production`, fill every value, then `make prod-pull prod-up`.
# Compose reads this file; the server, worker, and edge services receive the
# variables listed in docker-compose.prod.yml. Never commit `.env.production`.
# ==============================================================================

# Release whose server and worker images run (GHCR tag, no leading v), the
# same tag as the checkout in /srv/rotaria/repo. Rolling back is setting the
# previous version and `make prod-pull prod-up`.
ROTARIA_VERSION=0.1.3

# The one public origin for the web, the API, and the public pages (ADR-45).
DOMAIN=rotaria.site

# Cloudflare Tunnel connector token (Zero Trust, Networks, Tunnels) that
# carries traffic from Cloudflare to the edge. The Tunnel's public hostnames
# rotaria.site and www.rotaria.site point at http://edge:80; the edge
# publishes no port.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-tunnel-token

# Secrets below that end up inside a URL (Postgres, Redis) must be URL-safe:
# generate each with `openssl rand -hex 32`.

# Postgres superuser password for the bundled database service: it owns the
# schema and runs `make prod-migrate`, never the server or worker.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Password of rotaria_app, the non-superuser role server and worker connect
# as (row reads and writes only). Created with an empty volume; on an existing
# one, and after changing it, run `make prod-db-role`.
POSTGRES_APP_PASSWORD=replace-with-a-long-random-password

# Redis requires this password for every command (requirepass); the server
# and worker send it in REDIS_URL.
REDIS_PASSWORD=replace-with-a-long-random-password

# JWT signing secret: at least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters

# Object storage: Cloudflare R2 (buckets baca-epubs and baca-covers, APAC).
# The key is an R2 API token with Object Read and Write on those two buckets
# only; it cannot create buckets, so they must exist before the first boot.
# Server and worker share it; the backup bucket has its own token, never
# passed to server or worker (ADR-47).
# Production refuses to boot when either bucket does not answer to the key.
# R2 takes path-style and virtual-host requests alike; keep path style.
# Bundled MinIO instead: COMPOSE_PROFILES=minio, S3_ENDPOINT=http://minio:9000.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-access-key
S3_SECRET_ACCESS_KEY=replace-secret-key
S3_BUCKET_EPUBS=baca-epubs
S3_BUCKET_COVERS=baca-covers
S3_FORCE_PATH_STYLE=true

# Transactional email (OTP codes). Signup fails closed when SMTP is down.
# STARTTLS on 587 with authentication is the expected production setup.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=no-reply@rotaria.site
SMTP_FROM_NAME=Rotaria

# Gemini API key for embeddings and insight generation.
GEMINI_API_KEY=replace-with-gemini-key
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL_NAME=gemini-embedding-2

# Sentry DSN of the EU-region project, shared by server and worker; empty
# keeps error tracking off. Events carry no request body, header, cookie,
# query string, email, or book text.
SENTRY_DSN=

# Per-IP cap on unauthenticated catalog and insight reads per minute.
PUBLIC_RATE_LIMIT_PER_MINUTE=600
BOOK_SEARCH_RATE_LIMIT_PER_MINUTE=30

# Ceilings across every client together: signup mail per hour (past it
# signup answers 503) and semantic searches per day (past it 429).
# Production refuses to boot with either at 0.
OTP_HOURLY_BUDGET=100
AI_DAILY_BUDGET=5000

# Header the edge sets with the real client address. Caddyfile.prod takes
# CF-Connecting-IP only from cloudflared's network, writes it to
# X-Forwarded-For, and strips every other address header; keep the default.
# TRUSTED_IP_HEADER=x-forwarded-for
