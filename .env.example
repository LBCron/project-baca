# Project Baca local configuration. Copy to .env; every value below works
# with docker-compose.yml. Production values: .env.production.example.

# Server
APP_ENV=development
APP_PORT=8080
# Loopback only, like the compose services; the Android emulator still
# reaches it at 10.0.2.2. The server image binds 0.0.0.0 by default.
APP_HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost,http://tauri.localhost
LOG_FORMAT=text
# With TRUST_PROXY_HEADERS=true the client address is read from
# TRUSTED_IP_HEADER only; the edge must overwrite that header (Caddy sets
# X-Forwarded-For; behind Cloudflare use cf-connecting-ip).
TRUST_PROXY_HEADERS=false
TRUSTED_IP_HEADER=x-forwarded-for
# Per-IP cap on unauthenticated reads per minute; 0 disables it (dev and
# tests share one fallback IP). Production compose sets 600.
PUBLIC_RATE_LIMIT_PER_MINUTE=0
BOOK_SEARCH_RATE_LIMIT_PER_MINUTE=0
# Ceilings across every client on signup mail per hour and semantic
# searches per day; 0 disables them (production requires both above 0).
OTP_HOURLY_BUDGET=0
AI_DAILY_BUDGET=0

# Auth
JWT_SECRET=super-secret-jwt-key-replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRY_MINUTES=1440
JWT_REFRESH_EXPIRY_DAYS=14
SESSION_MAX_DAYS=90

# PostgreSQL 17 + pgvector
DATABASE_URL=postgres://baca_user:baca_password@localhost:5433/project_baca_db
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
# DATABASE_CONNECT_TIMEOUT_SECS=10
# DATABASE_IDLE_TIMEOUT_SECS=300
# DATABASE_STATEMENT_TIMEOUT_MS=5000

# Redis 7 (OTP, sessions, rate limits, streams)
REDIS_URL=redis://localhost:6380/0

# Object storage (MinIO locally; any S3-compatible store)
S3_ENDPOINT=http://localhost:9005
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_EPUBS=baca-epubs
S3_BUCKET_COVERS=baca-covers
S3_FORCE_PATH_STYLE=true

# Email (Mailpit locally). SMTP_SECURITY: starttls (default) or none.
# Credentials are sent only when SMTP_USER is set.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@projectbaca.local
SMTP_FROM_NAME="Project Baca"

# Embeddings: the self-hosted model service from `make embedder-up`.
# The server embeds search queries, the worker embeds chunks.
EMBEDDING_PROVIDER=tei
EMBEDDING_URL=http://127.0.0.1:8090
EMBEDDING_DIMENSION=768
# Worker only: cards and recaps through Claude Message Batches.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# LLM_MODEL_NAME=claude-sonnet-5-5
# LLM_BATCH_POLL_SECONDS=30
# RECLAIM_IDLE_MS=300000

# Web build only: baked into the WASM bundle by make build.
# API_BASE_URL=http://localhost:8080/api/v1
