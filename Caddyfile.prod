# Project Baca — production edge gateway for rotaria.site (ADR-45).
#
# Cloudflare terminates TLS and HTTP/3 and reaches this site through the
# Tunnel connector (cloudflared) on the compose `tunnel` network, so Caddy
# serves plain HTTP on :80 and obtains no certificate.
# Dev equivalent: Caddyfile (host-run, https://localhost, Trunk dev :3000).

{
	servers {
		# Client address: only the connector's fixed address may name the
		# client, through the CF-Connecting-IP header Cloudflare overwrites on
		# every request. Any other peer, a private address or the host's
		# bridge gateway included, is the client itself.
		trusted_proxies static {$TRUSTED_PROXY}
		client_ip_headers CF-Connecting-IP
	}
	# A stop lets in-flight requests finish before compose kills the edge.
	grace_period 25s
}

:80 {
	encode zstd gzip

	# Content-hashed build output and the self-hosted fonts (renamed, never
	# edited in place). The two matchers are exact complements.
	@immutable path_regexp ^/(?:[a-z0-9_-]+-[0-9a-f]{16}(?:_bg)?\.(?:wasm|js|css)|fonts/[^/]+\.woff2)$
	@revalidate not path_regexp ^/(?:[a-z0-9_-]+-[0-9a-f]{16}(?:_bg)?\.(?:wasm|js|css)|fonts/[^/]+\.woff2)$

	# No server banner on any response: proxied, static, or an error Caddy
	# writes itself (a 502 while the API restarts, a missing file).
	header -Server
	handle_errors {
		header -Server
	}

	# The Tunnel routes both the apex and www here; www moves to the apex for
	# good, path and query kept. Matching the name keeps the image free of a
	# baked domain, and only the Tunnel's own hostnames ever arrive.
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# Axum REST API. Swagger UI and the OpenAPI JSON are not mounted in
	# production, so they get no route here.
	#
	# The server reads the client only from X-Forwarded-For
	# (TRUSTED_IP_HEADER=x-forwarded-for), which the edge overwrites with the
	# address resolved above; every other address header a client may send
	# is stripped so it can never reach the API. While the server restarts,
	# a request waits for it instead of failing at once.
	handle /api/* {
		reverse_proxy http://server:8080 {
			header_up X-Forwarded-For {client_ip}
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			header_up -True-Client-IP
			header_up -Forwarded
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}

	# Leptos WASM SPA (static dist/, no Trunk dev server in prod).
	# Axum sets its own headers; the static shell needs them here. The Trunk
	# post_build hook externalizes the bootstrap script, so script-src needs
	# no 'unsafe-inline'; connect-src and img-src stay same-origin because the
	# API (covers included) shares the domain and the shell draws no data: or
	# blob: image. The shell has no <base>, so base-uri allows none.
	handle /* {
		root * /srv/web
		# Only routes fall back to the shell; a path with an extension is a
		# file (robots.txt, a hashed asset), and a missing one must be 404.
		@route {
			not file
			not path_regexp \.[A-Za-z0-9]+$
		}
		rewrite @route /index.html
		# The build writes .br and .gz beside each text file (brotli 11
		# ships the WASM a quarter smaller than on-the-fly gzip).
		file_server {
			precompressed br gzip
		}
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Resource-Policy "same-origin"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		# Hashed files are immutable for a year; the shell, service worker,
		# manifest, boot.js, icons, and illustrations revalidate, so a deploy
		# reaches returning readers on their next visit. API responses keep
		# the cache policy the server chose.
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @revalidate Cache-Control "no-cache"
	}

	# header_up Host is preserved by default. The server trusts the client
	# address header only because TRUST_PROXY_HEADERS=true on the server
	# service and this edge is the sole way in.
}
