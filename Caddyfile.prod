# Project Baca — production edge gateway.
#
# {$DOMAIN} comes from the compose environment (see .env.production.example).
# ACME is automatic; when Cloudflare proxies the domain, set the
# CF_DNS_TOKEN env and uncomment the dns line for DNS-01 challenges.
# Dev equivalent: Caddyfile (host-run, https://localhost, Trunk dev :3000).

{$DOMAIN} {
	encode gzip

	# Content-hashed build output and the self-hosted fonts (renamed, never
	# edited in place). The two matchers are exact complements.
	@immutable path_regexp ^/(?:[a-z0-9_-]+-[0-9a-f]{16}(?:_bg)?\.(?:wasm|js|css)|fonts/[^/]+\.woff2)$
	@revalidate not path_regexp ^/(?:[a-z0-9_-]+-[0-9a-f]{16}(?:_bg)?\.(?:wasm|js|css)|fonts/[^/]+\.woff2)$

	# No server banner on any response: proxied, static, or an error Caddy
	# writes itself (a 502 while the API restarts, a missing file).
	header -Server
	handle_errors {
		header -Server
	}

	# Axum REST API. Swagger UI and the OpenAPI JSON are not mounted in
	# production, so they get no route here.
	#
	# Client address: Caddy has no trusted_proxies configured, so it replaces
	# X-Forwarded-For with the real peer address; the server reads only that
	# header (TRUSTED_IP_HEADER=x-forwarded-for). Every other address header a
	# client may send is stripped so it can never reach the API. If Cloudflare
	# fronts this host, add trusted_proxies for its ranges and switch
	# TRUSTED_IP_HEADER to cf-connecting-ip instead of removing it here.
	handle /api/* {
		reverse_proxy http://server:8080 {
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			header_up -True-Client-IP
			header_up -Forwarded
		}
	}

	# Leptos WASM SPA (static dist/, no Trunk dev server in prod).
	# Axum sets its own headers; the static shell needs them here. The Trunk
	# post_build hook externalizes the bootstrap script, so script-src needs
	# no 'unsafe-inline'; connect-src stays same-origin because the API
	# shares the domain.
	handle /* {
		root * /srv/web
		# Only routes fall back to the shell; a path with an extension is a
		# file (robots.txt, a hashed asset), and a missing one must be 404.
		@route {
			not file
			not path_regexp \.[A-Za-z0-9]+$
		}
		rewrite @route /index.html
		file_server
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		# Hashed files are immutable for a year; the shell, service worker,
		# manifest, boot.js, icons, and illustrations revalidate, so a deploy
		# reaches returning readers on their next visit. API responses keep
		# the cache policy the server chose.
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @revalidate Cache-Control "no-cache"
	}


	# header_up Host is preserved by default. The server trusts the client
	# address header only because TRUST_PROXY_HEADERS=true on the server
	# service and this edge is the sole way in.
	# tls {
	# 	dns cloudflare {$CF_DNS_TOKEN}
	# }
}
